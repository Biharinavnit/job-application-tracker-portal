# Copy to server/.env and replace placeholders locally. Do not commit real secrets.
PORT=5000
NODE_ENV=development

# Keep your existing MongoDB URI and configure it only in server/.env.
MONGO_URI=mongodb://localhost:27017/job_tracker

# Use a long, random value; do not reuse this placeholder.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Local development: 0. Behind a reverse proxy, configure the exact trusted hop count.
TRUST_PROXY_HOPS=0

# Frontend origin used for CORS and password-reset links.
CLIENT_URL=http://localhost:3000

# SMTP provider settings. Configure all fields in server/.env before enabling reset email.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Private local document storage. Keep this outside any publicly served directory.
DOCUMENT_STORAGE_DIR=
MAX_DOCUMENT_SIZE_BYTES=10485760
