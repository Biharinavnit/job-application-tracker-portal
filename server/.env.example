# Copy to .env only if you do not already have a server/.env.
# Preserve your existing MongoDB Atlas URI and JWT secret.
PORT=5000
NODE_ENV=development
MONGO_URI=replace_with_your_existing_mongodb_uri
JWT_SECRET=replace_with_your_existing_jwt_secret
JWT_EXPIRES_IN=7d
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=replace_with_a_unique_seed_password

# Local development: 0. Behind a reverse proxy, set the exact number of trusted
# proxy hops and prevent clients from bypassing those proxies to reach this app.
TRUST_PROXY_HOPS=0

# Frontend origin used in reset links and CORS configuration.
CLIENT_URL=http://localhost:3000

# SMTP account settings (get these values from your email provider).
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=JobTrack <no-reply@your-domain.example>

# Private local document storage. Keep this outside any publicly served directory.
DOCUMENT_STORAGE_DIR=
MAX_DOCUMENT_SIZE_BYTES=10485760
TRASH_RETENTION_DAYS=30
